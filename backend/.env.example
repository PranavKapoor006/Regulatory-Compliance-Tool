APP_NAME=RegulaMosaic
FRONTEND_ORIGIN=http://localhost:5173
# Provenance only. The installed directive library is fully local and never
# sends runtime requests to this address.
FSCA_DIRECTIVES_URL=https://www.fsca.co.za/Supervisory-Information/?collapse=collapseEight
STORAGE_ROOT=storage
MAX_UPLOAD_MB=75

# Required only for scanned PDFs. Install Tesseract first.
# Windows default:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_DPI_SCALE=3.0

# Optional obligation extraction. The application remains usable when false.
ENABLE_LLM_EXTRACTION=false
# Gemini-assisted evidence review and tailored gap recommendations.
# When true, selected directive clauses and policy evidence are sent to Gemini.
ENABLE_LLM_GAP_REVIEW=false
GAP_REVIEW_BATCH_SIZE=5
GAP_REVIEW_CANDIDATES=3
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=6000

# Client-safe exports are the default. Set true only for internal QA/testing
# workbooks that need row-level percentage and confidence fields.
EXPORT_INTERNAL_QUALITY_METRICS=false

# Optional local fallback.
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
