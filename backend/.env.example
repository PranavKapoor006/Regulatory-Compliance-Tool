APP_NAME=EY Regulatory Compliance Tool
FRONTEND_ORIGIN=http://localhost:5173
FSCA_DIRECTIVES_URL=https://www2.fsca.co.za/Regulatory%20Frameworks/Pages/Directives.aspx
FSCA_CRAWLER_CACHE_SECONDS=300
STORAGE_ROOT=storage
MAX_UPLOAD_MB=75

# Required only for scanned PDFs. Install Tesseract first.
# Windows default:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_DPI_SCALE=3.0

# Optional. The application is fully usable with deterministic extraction when false.
ENABLE_LLM_EXTRACTION=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2400

# Optional local fallback.
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
